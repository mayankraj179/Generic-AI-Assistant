DATABASE_URL=postgresql+asyncpg://assistant:assistant_dev_password@localhost:5432/assistant_framework
REDIS_URL=redis://localhost:6379/0

ASSISTANT_CONFIGS_DIR=./configs

AUTH_ENABLED=true
AUTH_ISSUER=http://localhost:8080/realms/generic-ai-dev
AUTH_AUDIENCE=generic-ai-api
AUTH_JWKS_URL=http://localhost:8080/realms/generic-ai-dev/protocol/openid-connect/certs
AUTH_REQUIRED=true
DEVELOPMENT_PERMISSION_SET=assistant:use,conversation:read,conversation:write,retrieval:use,tool:invoke
DEVELOPMENT_LABELS=role:authenticated,scope:development

# Model provider credentials — fill in per environment, never commit real values
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
GEMINI_API_KEY=
GOOGLE_ADK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
# TEMP (testing): Azure AI Foundry, OpenAI-compatible v1 API. The endpoint is
# the resource's /openai/v1 base; it defaults to the hrinitiatives resource.
AZURE_AI_API_KEY=
AZURE_AI_ENDPOINT=https://hrinitiatives.services.ai.azure.com/openai/v1

# Observability — logs are JSON by default; LOG_FORMAT=text for a terminal.
LOG_LEVEL=INFO
LOG_FORMAT=json
# Traces: "none" (default), "otlp" to export to local Jaeger (docker compose
# up -d jaeger; UI http://localhost:16686; needs pip install '.[tracing]'),
# or "console".
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Knowledge sources for configs/kb_demo_assistant.yaml (dev values; the
# YAML only references these by name). Created by scripts/seed_kb_demo.py
# as least-privilege readers: a list/get-only MinIO user and a SELECT-only
# Postgres role on the kb_demo_source database.
KB_DEMO_S3_ACCESS_KEY=kb_reader
KB_DEMO_S3_SECRET_KEY=kb_reader_dev_password
KB_DEMO_DB_URL=postgresql+asyncpg://kb_reader:kb_reader_dev_password@localhost:5432/kb_demo_source
