# Copy to .env and adjust if your backend / Keycloak don't run on the defaults.
# All three are optional — these are the defaults used when unset.

# FastAPI backend (uvicorn app.main:app)
VITE_API_BASE=http://localhost:8000

# Keycloak realm + public client from infra/keycloak/realm-export.json
VITE_KEYCLOAK_ISSUER=http://localhost:8080/realms/generic-ai-dev
VITE_KEYCLOAK_CLIENT_ID=generic-ai-api
